# Rust
/target/
**/target/
**/*.rs.bk
*.pdb

# Windows binaries
*.exe
*.dll
*.exe~
!.agents/skills/indexing-folder/bin/aascribe.exe

# Log
*.log

# AAAgent
.aaagent_index_meta*
index_*.md
index.md
.cache/

# aascribe local store, config, and metadata (config dir holds API keys)
data/memory/
data/config/
data/logs/
**/.aascribe_index_meta.json
.DS*

# Local-only personal secrets
personal-info/secrets/

# Per-machine harness symlinks (recreated by docs/setup-repo-convention.js).
# Real skills live in .agents/skills/; .claude/skills is only a symlink to it,
# so it must NOT be committed — each machine creates its own.
/.claude/skills
